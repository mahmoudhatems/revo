{
  "note": "Authored (non-content-file) voice lines. Content-derived lines (briefings, feedback, hints, earth tips, card results) are generated by build-manifest.mjs from src/game/content/*. json. Emotion keys map to fixed style strings in build-manifest.mjs. priority: critical|crisis|story|result|reaction|decorative. play: steal|queue|skip. Text is verbatim what Neil says; on-screen text stays visible either way.",
  "lines": [
    { "id": "neil.hub.welcome", "text": "Welcome to Alpha Base, Rivo! Walk to the Command Dome with the yellow arrow and press USE.", "emotion": "happy", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.hub.next", "text": "Next mission! Walk to the Command Dome and press the USE button.", "emotion": "curious", "priority": "reaction", "group": null, "play": "skip" },

    { "id": "neil.m3.install", "text": "First the heater! The air-maker only works when it is super hot.", "emotion": "encouraging", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.c2.install", "text": "Ice is on 3 pipe joints! Wrap them with heating coils first.", "emotion": "worried", "priority": "story", "group": null, "play": "queue" },

    { "id": "neil.rover.prep-charge", "text": "Hold the charge button until the Rover bar turns green. Then we check your fitness!", "emotion": "encouraging", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.prep-peak", "text": "Fitness check: peak fitness! You carried the Beacon with no strain, so you have all 10 Move Points.", "emotion": "proud", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.prep-tired", "text": "Fitness check: Rivo is tired and struggled with the Beacon. That cost 1 power and 1 air, and you start with 9 Move Points.", "emotion": "encouraging", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.launch", "text": "Rivo puts on the spacesuit helmet. When should we drive out?", "emotion": "curious", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.grid", "text": "Mountains eat lots of Rover power, but flat roads take longer and use more air. Choose your path wisely!", "emotion": "curious", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.arrive", "text": "You made it to the green Landing Zone! Plant the Beacon and press the big red button!", "emotion": "celebrating", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.towed", "text": "The Robot towed the Rover to the Landing Zone. Plant the Beacon and press the big red button!", "emotion": "relieved", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.rover.signal", "text": "Green radio waves pulse from Mars to Earth...", "emotion": "thinking", "priority": "decorative", "group": null, "play": "queue" },

    { "id": "neil.c4.fuse-overload", "text": "ZAP! More than 10 Amps. The breaker blew, and the wires reset to basic life support.", "emotion": "surprised", "priority": "result", "group": null, "play": "queue" },
    { "id": "neil.c4.fuse-smart", "text": "Air-Maker, Heater, and Shield Pump: 9 Amps exactly. The fuse LEDs glow green and the lights come back!", "emotion": "celebrating", "priority": "result", "group": null, "play": "queue" },
    { "id": "neil.c4.fuse-minimal", "text": "Air-Maker and Heater: 7 Amps. Very safe, but the unpowered shield pump loses 1 shield bar.", "emotion": "relieved", "priority": "result", "group": null, "play": "queue" },
    { "id": "neil.c4.fuse-partial", "text": "The breaker holds, but an important machine had no power. Life support struggled.", "emotion": "worried", "priority": "result", "group": null, "play": "queue" },

    { "id": "neil.ending.legendary", "text": "Fireworks! All four meters are green and you never needed the capsule. You earned the Mars Hero Medal, and the base is 100% ready for the Ares-2 crew!", "emotion": "celebrating", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.ending.cautious", "text": "Ares-2 lands safely, and the crew helps top up what was low. Great teamwork!", "emotion": "proud", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.ending.emergency", "text": "The base protected Rivo in the Escape Pod until Ares-2 arrived. Rivo is safe!", "emotion": "relieved", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.ending.emergency-reassure", "text": "Nothing bad happened to you, Rivo. The capsule did its job. Every commander learns from a rough Sol!", "emotion": "encouraging", "priority": "reaction", "group": null, "play": "queue" },

    { "id": "neil.report.final", "text": "Every mission used real saved NASA and CSA records. You are a true Mars Commander!", "emotion": "proud", "priority": "story", "group": null, "play": "queue" },

    { "id": "neil.alert.capsule", "text": "Don't worry, Rivo! The capsule is keeping you safe while the base restarts.", "emotion": "encouraging", "priority": "critical", "group": null, "play": "steal" },
    { "id": "neil.alert.pod", "text": "The base is protecting you in the Escape Pod, Rivo. You are safe!", "emotion": "encouraging", "priority": "critical", "group": null, "play": "steal" },
    { "id": "neil.alert.water", "text": "The water tank is empty! Rivo is thirsty.", "emotion": "worried", "priority": "critical", "group": null, "play": "steal" },
    { "id": "neil.alert.thirst", "text": "No water machine: Rivo is getting thirsty.", "emotion": "worried", "priority": "critical", "group": null, "play": "steal" },

    { "id": "neil.crisis.c1-warn", "text": "The sky is turning brown... the panels are losing the Sun!", "emotion": "worried", "priority": "crisis", "group": null, "play": "skip" },
    { "id": "neil.crisis.c1-ok", "text": "The Sun is coming back! The panels can breathe.", "emotion": "relieved", "priority": "reaction", "group": null, "play": "skip" },
    { "id": "neil.crisis.c2-warn", "text": "Brr! Frost is creeping over the pipes, Rivo!", "emotion": "worried", "priority": "crisis", "group": null, "play": "skip" },
    { "id": "neil.crisis.c2-ok", "text": "Warm coils, flowing pipes. Nice and toasty again!", "emotion": "relieved", "priority": "reaction", "group": null, "play": "skip" },
    { "id": "neil.crisis.c3-tick", "text": "Any second now, Rivo! Pick a card and pull the lever!", "emotion": "emergency", "priority": "crisis", "group": null, "play": "steal" },
    { "id": "neil.crisis.c4-back", "text": "Power is back! And you fixed it all by yourself, Commander.", "emotion": "proud", "priority": "reaction", "group": null, "play": "skip" },
    { "id": "neil.crisis.c5-warn", "text": "Your muscles are getting sleepy in the low gravity, Rivo.", "emotion": "worried", "priority": "crisis", "group": null, "play": "skip" },
    { "id": "neil.crisis.c5-ok", "text": "Now THAT is a spring in your step!", "emotion": "happy", "priority": "reaction", "group": null, "play": "skip" },

    { "id": "neil.reaction.good.01", "text": "Beautifully done, Rivo!", "emotion": "proud", "priority": "reaction", "group": "good", "play": "skip" },
    { "id": "neil.reaction.good.02", "text": "That's a clever move!", "emotion": "happy", "priority": "reaction", "group": "good", "play": "skip" },
    { "id": "neil.reaction.good.03", "text": "Ooh, the colony likes that!", "emotion": "happy", "priority": "reaction", "group": "good", "play": "skip" },
    { "id": "neil.reaction.good.04", "text": "Look at us go!", "emotion": "celebrating", "priority": "reaction", "group": "good", "play": "skip" },
    { "id": "neil.reaction.good.05", "text": "You made that look easy!", "emotion": "proud", "priority": "reaction", "group": "good", "play": "skip" },
    { "id": "neil.reaction.good.06", "text": "Systems are smiling today!", "emotion": "happy", "priority": "reaction", "group": "good", "play": "skip" },

    { "id": "neil.reaction.careful.01", "text": "That's one way to do it, Rivo.", "emotion": "curious", "priority": "reaction", "group": "careful", "play": "skip" },
    { "id": "neil.reaction.careful.02", "text": "Hmm! Let's keep an eye on the meters.", "emotion": "thinking", "priority": "reaction", "group": "careful", "play": "skip" },
    { "id": "neil.reaction.careful.03", "text": "We can make that work!", "emotion": "encouraging", "priority": "reaction", "group": "careful", "play": "skip" },
    { "id": "neil.reaction.careful.04", "text": "Bold choice! We'll adapt as we go.", "emotion": "curious", "priority": "reaction", "group": "careful", "play": "skip" },

    { "id": "neil.reaction.mistake.01", "text": "That's okay! Every commander learns.", "emotion": "encouraging", "priority": "reaction", "group": "mistake", "play": "skip" },
    { "id": "neil.reaction.mistake.02", "text": "Oops! Let's fix it together.", "emotion": "encouraging", "priority": "reaction", "group": "mistake", "play": "skip" },
    { "id": "neil.reaction.mistake.03", "text": "Mistakes are how we learn, Rivo.", "emotion": "encouraging", "priority": "reaction", "group": "mistake", "play": "skip" },
    { "id": "neil.reaction.mistake.04", "text": "Not the best pick. We'll know next time!", "emotion": "encouraging", "priority": "reaction", "group": "mistake", "play": "skip" },

    { "id": "neil.reaction.celebrate.01", "text": "Yes! We did it!", "emotion": "celebrating", "priority": "reaction", "group": "celebrate", "play": "skip" },
    { "id": "neil.reaction.celebrate.02", "text": "Hooray for Team Rivo!", "emotion": "celebrating", "priority": "reaction", "group": "celebrate", "play": "skip" },
    { "id": "neil.reaction.celebrate.03", "text": "This is a great day for Mars!", "emotion": "celebrating", "priority": "reaction", "group": "celebrate", "play": "skip" },
    { "id": "neil.reaction.celebrate.04", "text": "Superb, Commander!", "emotion": "proud", "priority": "reaction", "group": "celebrate", "play": "skip" },

    { "id": "neil.reaction.sticker.01", "text": "A brand new sticker for the album!", "emotion": "celebrating", "priority": "reaction", "group": "sticker", "play": "skip" },
    { "id": "neil.reaction.sticker.02", "text": "Ooh, shiny! That one is earned.", "emotion": "happy", "priority": "reaction", "group": "sticker", "play": "skip" },
    { "id": "neil.reaction.sticker.03", "text": "What a cool sticker!", "emotion": "surprised", "priority": "reaction", "group": "sticker", "play": "skip" },
    { "id": "neil.reaction.sticker.04", "text": "The collection is growing!", "emotion": "happy", "priority": "reaction", "group": "sticker", "play": "skip" },
    { "id": "neil.reaction.sticker.05", "text": "Sticker secured!", "emotion": "celebrating", "priority": "reaction", "group": "sticker", "play": "skip" },

    { "id": "neil.reaction.unlock.01", "text": "We just unlocked something new!", "emotion": "surprised", "priority": "reaction", "group": "unlock", "play": "skip" },
    { "id": "neil.reaction.unlock.02", "text": "Look what you opened up, Rivo!", "emotion": "proud", "priority": "reaction", "group": "unlock", "play": "skip" },
    { "id": "neil.reaction.unlock.03", "text": "New gear! That might help later.", "emotion": "curious", "priority": "reaction", "group": "unlock", "play": "skip" },

    { "id": "neil.reaction.surprise.01", "text": "Whoa!", "emotion": "surprised", "priority": "decorative", "group": "surprise", "play": "skip" },
    { "id": "neil.reaction.surprise.02", "text": "Oh!", "emotion": "surprised", "priority": "decorative", "group": "surprise", "play": "skip" },
    { "id": "neil.reaction.surprise.03", "text": "Wow!", "emotion": "surprised", "priority": "decorative", "group": "surprise", "play": "skip" },

    { "id": "neil.reaction.relief.01", "text": "Phew!", "emotion": "relieved", "priority": "decorative", "group": "relief", "play": "skip" },
    { "id": "neil.reaction.relief.02", "text": "Safe at last!", "emotion": "relieved", "priority": "decorative", "group": "relief", "play": "skip" },
    { "id": "neil.reaction.relief.03", "text": "That was close!", "emotion": "relieved", "priority": "decorative", "group": "relief", "play": "skip" },

    { "id": "neil.reaction.encourage.01", "text": "Let's try again!", "emotion": "encouraging", "priority": "decorative", "group": "encourage", "play": "skip" },
    { "id": "neil.reaction.encourage.02", "text": "You've got this, Rivo!", "emotion": "encouraging", "priority": "decorative", "group": "encourage", "play": "skip" },
    { "id": "neil.reaction.encourage.03", "text": "One step at a time!", "emotion": "encouraging", "priority": "decorative", "group": "encourage", "play": "skip" },

    { "id": "neil.reaction.think.01", "text": "Let's see...", "emotion": "thinking", "priority": "decorative", "group": "think", "play": "skip" },
    { "id": "neil.reaction.think.02", "text": "Hmm, interesting...", "emotion": "thinking", "priority": "decorative", "group": "think", "play": "skip" },

    { "id": "neil.reaction.return.01", "text": "Welcome back to the colony!", "emotion": "happy", "priority": "reaction", "group": "return", "play": "skip" },
    { "id": "neil.reaction.return.02", "text": "Home sweet Mars home!", "emotion": "happy", "priority": "reaction", "group": "return", "play": "skip" },
    { "id": "neil.reaction.return.03", "text": "The base missed you, Rivo!", "emotion": "happy", "priority": "reaction", "group": "return", "play": "skip" },

    { "id": "neil.reaction.rover-depart.01", "text": "Wheels up! Off we roll.", "emotion": "celebrating", "priority": "reaction", "group": "rover-depart", "play": "skip" },
    { "id": "neil.reaction.rover-depart.02", "text": "Full ahead, Rover!", "emotion": "happy", "priority": "reaction", "group": "rover-depart", "play": "skip" },
    { "id": "neil.reaction.rover-low.01", "text": "Careful with the Move Points, Rivo!", "emotion": "worried", "priority": "crisis", "group": "rover-low", "play": "skip" },
    { "id": "neil.reaction.rover-low.02", "text": "Hmm, not many points left. Pick flat ground!", "emotion": "thinking", "priority": "crisis", "group": "rover-low", "play": "skip" },
    { "id": "neil.reaction.rover-scout.01", "text": "Sending the scout to peek ahead!", "emotion": "curious", "priority": "reaction", "group": "rover-scout", "play": "skip" },
    { "id": "neil.reaction.rover-scout.02", "text": "The scout found us a path!", "emotion": "happy", "priority": "reaction", "group": "rover-scout", "play": "skip" },
    { "id": "neil.reaction.rover-beacon.01", "text": "Beacon planted! Now for the big red button!", "emotion": "celebrating", "priority": "reaction", "group": "rover-beacon", "play": "skip" },
    { "id": "neil.reaction.rover-tow.01", "text": "Phew, thanks Robot!", "emotion": "relieved", "priority": "reaction", "group": "rover-tow", "play": "skip" },
    { "id": "neil.reaction.rover-tow.02", "text": "Towed to safety! Smart save.", "emotion": "relieved", "priority": "reaction", "group": "rover-tow", "play": "skip" },

    { "id": "neil.reaction.low-power.01", "text": "The battery is getting low, Rivo!", "emotion": "worried", "priority": "crisis", "group": "low-power", "play": "skip" },
    { "id": "neil.reaction.low-power.02", "text": "The lights are dimming...", "emotion": "worried", "priority": "crisis", "group": "low-power", "play": "skip" },
    { "id": "neil.reaction.low-water.01", "text": "The water tank is running low.", "emotion": "worried", "priority": "crisis", "group": "low-water", "play": "skip" },
    { "id": "neil.reaction.low-water.02", "text": "Let's be kind to the water drops!", "emotion": "thinking", "priority": "crisis", "group": "low-water", "play": "skip" },
    { "id": "neil.reaction.low-oxygen.01", "text": "The air bar is getting low, Rivo!", "emotion": "worried", "priority": "crisis", "group": "low-oxygen", "play": "skip" },
    { "id": "neil.reaction.low-oxygen.02", "text": "We need the air-maker happy!", "emotion": "thinking", "priority": "crisis", "group": "low-oxygen", "play": "skip" },
    { "id": "neil.reaction.low-shield.01", "text": "The shield is getting thin, Rivo.", "emotion": "worried", "priority": "crisis", "group": "low-shield", "play": "skip" },
    { "id": "neil.reaction.low-shield.02", "text": "More space rays are sneaking through!", "emotion": "worried", "priority": "crisis", "group": "low-shield", "play": "skip" },
    { "id": "neil.reaction.low-heart.01", "text": "Your heart bar is low, Rivo.", "emotion": "worried", "priority": "crisis", "group": "low-heart", "play": "skip" },
    { "id": "neil.reaction.low-heart.02", "text": "You need a snack and a good rest!", "emotion": "encouraging", "priority": "crisis", "group": "low-heart", "play": "skip" },

    { "id": "neil.reaction.sleep", "text": "Sleep tight, Commander.", "emotion": "encouraging", "priority": "decorative", "group": null, "play": "skip" },
    { "id": "neil.reaction.wake", "text": "Good morning, Mars!", "emotion": "happy", "priority": "decorative", "group": null, "play": "skip" },

    { "id": "neil.summary.phase1", "text": "Your 10 setup days are up! Mars storms start tomorrow, on Sol 11!", "emotion": "worried", "priority": "story", "group": null, "play": "queue" },
    { "id": "neil.summary.phase2", "text": "You survived the toughest 16 Sols! Only 4 days to go, and tomorrow we prep the Rover!", "emotion": "celebrating", "priority": "story", "group": null, "play": "queue" }
  ]
}
